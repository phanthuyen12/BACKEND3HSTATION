# Có thể nhập nguyên link Google Sheet hoặc chỉ Spreadsheet ID.
GOOGLE_SHEETS_SPREADSHEET=https://docs.google.com/spreadsheets/d/THAY_SHEET_ID/edit

# Mỗi landing dùng một tab riêng và được tự tạo khi có lead đầu tiên.
# Ví dụ: Landing 6, Landing 7. Có thể đổi tiền tố bên dưới.
GOOGLE_SHEETS_TAB_PREFIX=Landing

# Khuyến nghị: tải file JSON riêng tư vào đúng đường dẫn này trên backend.
# TUYỆT ĐỐI không đặt file trong public, uploads hoặc commit lên Git.
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=./config/credentials/google-service-account.json

# Hai cách thay thế (chỉ chọn một nếu máy chủ không hỗ trợ lưu file):
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# GOOGLE_SHEETS_SERVICE_ACCOUNT_BASE64=

# Nhớ chia sẻ Google Sheet cho client_email trong JSON với quyền Editor.
